#!/bin/bash

[ -n "$VERBOSE" ] && echo "postrm called with argument \`$1'" >&2
[ -n "$VERBOSE" ] && set -x

#
# summary of how this script can be called:
#        * <postrm> `remove' 
#        * <postrm> `purge'
#        * <old-postrm> `upgrade' <new-version>
#        * <new-postrm> `failed-upgrade' <old-version>
#        * <new-postrm> `abort-install'
#        * <new-postrm> `abort-install' <old-version>
#        * <new-postrm> `abort-upgrade' <old-version>
#        * <disappearer's-postrm> `disappear' <overwriter>
#          <overwriter-version>
#
SSL_CLIENT=__PREFIX__/hadoop/hadoop-__VERSION_3DIGIT__/etc/hadoop/ssl-client.xml
SSL_SERVER=__PREFIX__/hadoop/hadoop-__VERSION_3DIGIT__/etc/hadoop/ssl-server.xml
if [ -f "$SSL_CLIENT" ] && [ ! -f "$SSL_CLIENT".bak ]; then
  storePass=$(awk '/ssl.client.truststore.password/{getline; print}' "$SSL_CLIENT" | sed 's/\s*<value>\(.*\)<\/value>/\1/')
  if [ "$storePass" != "mapr123" ]; then
    cp "$SSL_CLIENT" "$SSL_CLIENT".bak
  fi
fi

if [ -f "$SSL_SERVER" ] && [ ! -f "$SSL_SERVER".bak ]; then
  storePass=$(awk '/ssl.server.keystore.password/{getline; print}' "$SSL_SERVER" | sed 's/\s*<value>\(.*\)<\/value>/\1/')
  if [ "$storePass" != "mapr123" ]; then
    cp "$SSL_SERVER" "$SSL_SERVER".bak
  fi
fi

case "$1" in
    upgrade)
    ;;

    remove|purge|disappear)
        #
        # When doing a uninstall, remove all the symlinks, backup, and
        # post-install generated files that were created during installation.
        #
        rm -f  /usr/bin/hadoop
        rm -f  /usr/bin/mapred-config.sh
        rm -f __PREFIX__/conf/ssl-client.xml
        rm -f __PREFIX__/conf/ssl-server.xml

        rm -f  __PREFIX__/hadoop/hadoop-__VERSION_3DIGIT__/share/hadoop/common/lib/slf4j*.jar
        rm -f  __PREFIX__/hadoop/hadoop-__VERSION_3DIGIT__/share/hadoop/common/lib/mapr-hbase*.jar
        rm -f  __PREFIX__/hadoop/hadoop-__VERSION_3DIGIT__/share/hadoop/common/lib/mysql-connector-java*.jar
        rm -f  __PREFIX__/hadoop/hadoop-__VERSION_3DIGIT__/share/hadoop/common/lib/libMapRClient.so
        rm -f  __PREFIX__/hadoop/hadoop-__VERSION_3DIGIT__/lib/native/libMapRClient.so
        rm -f  __PREFIX__/hadoop/hadoop-__VERSION_3DIGIT__/lib/native/libjpam.so
        rm -f  __PREFIX__/hadoop/hadoop-__VERSION_3DIGIT__/share/hadoop/common/lib/maprfs-*.jar
        rm -f  __PREFIX__/hadoop/hadoop-__VERSION_3DIGIT__/share/hadoop/common/lib/maprutil-*.jar
        rm -f  __PREFIX__/hadoop/hadoop-__VERSION_3DIGIT__/share/hadoop/common/lib/json-*.jar
        rm -f  __PREFIX__/hadoop/hadoop-__VERSION_3DIGIT__/share/hadoop/common/lib/libprotodefs-*.jar
        rm -f  __PREFIX__/hadoop/hadoop-__VERSION_3DIGIT__/share/hadoop/common/lib/central-logging-*.jar


        rm -f  __PREFIX__/lib/commons-io-*.jar
        rm -f  __PREFIX__/lib/commons-configuration*.jar
        rm -f  __PREFIX__/lib/hadoop-auth-*.jar
        rm -f  __PREFIX__/lib/hadoop-common-*.jar
        rm -f  __PREFIX__/lib/hadoop-yarn-api-*.jar
        rm -f  __PREFIX__/lib/htrace-*.jar

        rm -rf __PREFIX__/hadoop/OLD_HADOOP_VERSIONS
    ;;

    abort-install|abort-upgrade|failed-upgrade)
    ;;  
        
    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac


